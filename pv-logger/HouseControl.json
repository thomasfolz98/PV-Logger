    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT SUM(produced) AS erzeugt_wh, SUM(consumed) AS eigenverbrauch_wh, SUM(injected) AS eingespeist_wh, COUNT(*) AS tage, MIN(date_of_production)::text AS von, MAX(date_of_production)::text AS bis FROM production_data WHERE date_of_production BETWEEN $1::date AND $2::date",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify([$json.start, $json.end]) }}"
        }
