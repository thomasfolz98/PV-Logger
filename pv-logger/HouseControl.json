        "jsCode": "const p = $('Parse Command').first().json;\nconst text = `✅ Strompreis gespeichert!\\n\\nPreis: ${p.price} Cent/kWh\\nMwSt: ${p.vat}%\\nGültig ab: ${p.validFrom}${p.validTo ? '\\nBis: ' + p.validTo : '\\n(kein Enddatum – aktuell gültig)'}`;\nreturn [{ json: { chatId: p.chatId, text } }];"
