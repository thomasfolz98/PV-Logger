    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ROUND(SUM(pd.consumed::numeric / 1000.0 * COALESCE(ep.price_per_kwh, 0) / 100.0 * COALESCE(ep.vat_rate, 0) / 100.0), 2) AS ust_betrag_euro, SUM(pd.consumed) AS eigenverbrauch_wh, COUNT(pd.id) AS tage, COUNT(ep.id) AS tage_mit_preis FROM production_data pd LEFT JOIN electricity_prices ep ON pd.date_of_production >= ep.valid_from AND pd.date_of_production <= COALESCE(ep.valid_to, 'infinity'::date) WHERE EXTRACT(YEAR FROM pd.date_of_production) = $1",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify([$json.year]) }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        700,
        0
      ],
      "id": "88888888-8888-8888-8888-888888888888",
      "name": "Calculate USt",
      "credentials": {
        "postgres": {
          "id": "5wqNDmUcGKtmTFHA",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst p = $('Parse Command').first().json;\nconst ust = parseFloat(row.ust_betrag_euro || 0);\nconst kwh = (parseInt(row.eigenverbrauch_wh || 0) / 1000).toFixed(1);\nconst tage = parseInt(row.tage || 0);\nconst tageMitPreis = parseInt(row.tage_mit_preis || 0);\nconst tageOhnePreis = tage - tageMitPreis;\n\nlet text = `📊 Umsatzsteuer ${p.year}\\n\\n`;\ntext += `Eigenverbrauch: ${kwh.replace('.', ',')} kWh\\n`;\ntext += `Erfasste Tage: ${tage}`;\nif (tageOhnePreis > 0) {\n  text += ` (⚠️ ${tageOhnePreis} Tage ohne Strompreis!)`;\n}\ntext += `\\n\\n💶 USt-Betrag: ${ust.toFixed(2).replace('.', ',')} €\\n\\n👉 Diesen Betrag in das Elster-Formular eintragen.`;\n\nreturn [{ json: { chatId: p.chatId, text } }];"
      },
