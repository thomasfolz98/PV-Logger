        700,
        300
      ],
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "name": "Get Statistics",
      "credentials": {
        "postgres": {
          "id": "5wqNDmUcGKtmTFHA",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst p = $('Parse Command').first().json;\n\nif (!row.tage || parseInt(row.tage) === 0) {\n  return [{ json: { chatId: p.chatId, text: `⚠️ Keine Daten für den Zeitraum ${p.start} bis ${p.end} gefunden.` } }];\n}\n\nconst erzeugt = parseInt(row.erzeugt_wh || 0);\nconst eigen = parseInt(row.eigenverbrauch_wh || 0);\nconst eingespeist = parseInt(row.eingespeist_wh || 0);\nconst tage = parseInt(row.tage);\nconst quote = erzeugt > 0 ? Math.round(eigen / erzeugt * 100) : 0;\nconst fmt = (wh) => (wh / 1000).toFixed(1).replace('.', ',') + ' kWh';\n\nconst text = `⚡ Auswertung ${row.von} bis ${row.bis} (${tage} Tage)\\n\\nErzeugt:          ${fmt(erzeugt)}\\nEigenverbrauch:   ${fmt(eigen)} (${quote}%)\\nEingespeist:      ${fmt(eingespeist)}`;\nreturn [{ json: { chatId: p.chatId, text } }];"
      },
