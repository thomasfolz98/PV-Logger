# Telegram — Benachrichtigungen und KI-Auswertung
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Anthropic Claude API — für die abendliche KI-Auswertung
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL — Defaults passen zum docker-compose.yml (nur bei Bedarf ändern)
POSTGRES_DB=pvmonitor
POSTGRES_USER=pv
POSTGRES_PASSWORD=pv

# n8n — Encryption Key (beliebiger String, muss stabil bleiben)
N8N_ENCRYPTION_KEY=changeme-use-a-random-string-here
